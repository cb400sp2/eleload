{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/cb400sp2/eleload/schema/report-v1.json",
    "title": "eleload Report v1",
    "description": "Schema for eleload JSON load-test reports (schema_version=1)",
    "type": "object",
    "required": ["target", "config", "summary", "errors", "time_buckets", "meta"],
    "additionalProperties": false,
    "properties": {
        "target": {
            "type": "object",
            "required": ["url", "method"],
            "additionalProperties": false,
            "properties": {
                "url":    { "type": "string", "minLength": 1 },
                "method": { "type": "string", "minLength": 1 }
            }
        },
        "config": {
            "type": "object",
            "required": ["requests", "concurrency", "timeout", "follow_redirects", "http_version", "dns_cache_ttl", "name",
                         "success_status", "expect_status", "expect_body_contains",
                         "duration", "warmup", "ramp_up", "rate", "target_rps", "target_tps"],
            "additionalProperties": false,
            "properties": {
                "requests":             { "type": ["integer", "null"], "minimum": 0 },
                "concurrency":          { "type": "integer", "minimum": 1 },
                "timeout":              { "type": "integer", "minimum": 0 },
                "follow_redirects":     { "type": "boolean" },
                "http_version":         { "type": "string", "enum": ["1.0", "1.1", "2.0", "3.0"] },
                "dns_cache_ttl":        { "type": "integer", "minimum": -1 },
                "name":                 { "type": ["string", "null"] },
                "success_status":       { "type": ["array", "null"], "items": { "type": "integer" } },
                "expect_status":        { "type": ["array", "null"], "items": { "type": "integer" } },
                "expect_body_contains": { "type": ["string", "null"] },
                "duration":             { "type": ["number", "null"], "minimum": 0 },
                "warmup":               { "type": "number", "minimum": 0 },
                "ramp_up":              { "type": ["number", "null"], "minimum": 0 },
                "rate":                 { "type": ["number", "null"], "minimum": 0 },
                "target_rps":           { "type": ["number", "null"], "minimum": 0 },
                "target_tps":           { "type": ["number", "null"], "minimum": 0 }
            }
        },
        "summary": {
            "type": "object",
            "required": ["duration_sec", "total_duration_sec", "requests", "throughput",
                         "latency", "status_codes", "slowest_requests"],
            "additionalProperties": false,
            "properties": {
                "duration_sec":       { "type": "number", "minimum": 0 },
                "total_duration_sec": { "type": "number", "minimum": 0 },
                "requests": {
                    "type": "object",
                    "required": ["total", "executed", "warmup", "success", "failed",
                                 "success_rate", "error_rate"],
                    "additionalProperties": false,
                    "properties": {
                        "total":        { "type": "integer", "minimum": 0 },
                        "executed":     { "type": "integer", "minimum": 0 },
                        "warmup":       { "type": "integer", "minimum": 0 },
                        "success":      { "type": "integer", "minimum": 0 },
                        "failed":       { "type": "integer", "minimum": 0 },
                        "success_rate": { "type": "number", "minimum": 0, "maximum": 100 },
                        "error_rate":   { "type": "number", "minimum": 0, "maximum": 100 }
                    }
                },
                "throughput": {
                    "type": "object",
                    "required": ["rps", "tps", "tps_rps_rate"],
                    "additionalProperties": false,
                    "properties": {
                        "rps":                  { "type": "number", "minimum": 0 },
                        "tps":                  { "type": "number", "minimum": 0 },
                        "tps_rps_rate":         { "type": "number", "minimum": 0, "maximum": 100 },
                        "target_rps":           { "type": "number", "minimum": 0 },
                        "rps_achievement_rate": { "type": "number", "minimum": 0 },
                        "target_tps":           { "type": "number", "minimum": 0 },
                        "tps_achievement_rate": { "type": "number", "minimum": 0 }
                    }
                },
                "latency": {
                    "type": "object",
                    "required": ["min", "avg", "p50", "p95", "p99", "max"],
                    "additionalProperties": false,
                    "properties": {
                        "min": { "type": "number", "minimum": 0 },
                        "avg": { "type": "number", "minimum": 0 },
                        "p50": { "type": "number", "minimum": 0 },
                        "p95": { "type": "number", "minimum": 0 },
                        "p99": { "type": "number", "minimum": 0 },
                        "max": { "type": "number", "minimum": 0 }
                    }
                },
                "status_codes": {
                    "type": ["object", "array"],
                    "additionalProperties": {
                        "type": "object",
                        "required": ["count", "rate"],
                        "additionalProperties": false,
                        "properties": {
                            "count": { "type": "integer", "minimum": 0 },
                            "rate":  { "type": "number", "minimum": 0, "maximum": 100 }
                        }
                    }
                },
                "slowest_requests": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["request", "http_code", "latency_ms", "success"],
                        "properties": {
                            "request":    { "type": "integer", "minimum": 1 },
                            "http_code":  { "type": "integer", "minimum": 0 },
                            "latency_ms": { "type": "number", "minimum": 0 },
                            "success":    { "type": "boolean" }
                        }
                    }
                }
            }
        },
        "errors": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["request", "http_code", "error_no", "error", "latency_ms"],
                "additionalProperties": false,
                "properties": {
                    "request":                { "type": "integer", "minimum": 1 },
                    "http_code":              { "type": "integer", "minimum": 0 },
                    "error_no":               { "type": "integer" },
                    "error":                  { "type": "string" },
                    "latency_ms":             { "type": "number", "minimum": 0 },
                    "download_bytes":         { "type": "number", "minimum": 0 },
                    "body_contains_expected": { "type": ["boolean", "null"] },
                    "success":                { "type": "boolean" }
                }
            }
        },
        "time_buckets": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["t", "rps", "tps", "error_rate", "avg_latency_ms"],
                "additionalProperties": false,
                "properties": {
                    "t":              { "type": "integer", "minimum": 0 },
                    "rps":            { "type": "number", "minimum": 0 },
                    "tps":            { "type": "number", "minimum": 0 },
                    "error_rate":     { "type": "number", "minimum": 0, "maximum": 100 },
                    "avg_latency_ms": { "type": "number", "minimum": 0 }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": ["tool", "version", "schema_version", "test_name"],
            "additionalProperties": false,
            "properties": {
                "tool":           { "type": "string", "const": "eleload" },
                "version":        { "type": "string", "minLength": 1 },
                "schema_version": { "type": "integer", "const": 1 },
                "test_name":      { "type": ["string", "null"] }
            }
        }
    }
}
